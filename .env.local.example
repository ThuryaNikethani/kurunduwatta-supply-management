# Supabase — Project Settings → Data API (URL) and API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only. Never share or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# Web Push popups. Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Protects the daily keep-alive and weekly backup jobs (any long random string)
CRON_SECRET=

# demo = browser-only practice data; supabase = real database
NEXT_PUBLIC_BACKEND=supabase

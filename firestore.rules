rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid)) && me().active == true;
    }
    function isRole(r) { return hasProfile() && me().role == r; }

    // Allowed status moves for each role (see src/lib/workflow.ts).
    function transitionOk() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      let r = me().role;
      return (r == 'chef' && from == 'returned_to_chef' && to == 'pending_supervisor')
        || (r == 'supervisor'
            && (from == 'pending_supervisor' || from == 'returned_to_supervisor')
            && (to == 'pending_hr' || to == 'returned_to_chef'))
        || (r == 'hr' && from == 'pending_hr' && (to == 'approved' || to == 'returned_to_supervisor'));
    }

    // Only the chef may change list contents (when resending); others only
    // move the status and add history.
    function contentUnchangedUnlessChef() {
      return me().role == 'chef'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'history', 'updatedAt']);
    }

    // First-run setup: creating meta/setup and the first HR user together.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/setup)
        && getAfter(userPath(request.auth.uid)).data.role == 'hr';
    }

    match /users/{uid} {
      allow read: if hasProfile() || (signedIn() && request.auth.uid == uid);
      allow create: if isRole('hr')
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'hr'
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup));
      allow update: if isRole('hr')
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']));
      allow delete: if isRole('hr');

      match /notifications/{nid} {
        allow create: if hasProfile();
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /recipes/{id} {
      allow read: if hasProfile();
      allow write: if isRole('chef') || isRole('hr');
    }

    match /supplyLists/{id} {
      allow read: if hasProfile();
      allow create: if isRole('chef')
        && request.resource.data.status == 'pending_supervisor'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasProfile() && transitionOk() && contentUnchangedUnlessChef();
    }

    match /transferOuts/{id} {
      allow read: if hasProfile();
      allow create: if isRole('chef')
        && request.resource.data.status == 'pending_supervisor'
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/supplyLists/$(request.resource.data.supplyId)).data.status == 'approved';
      allow update: if hasProfile() && transitionOk() && contentUnchangedUnlessChef();
    }
  }
}
